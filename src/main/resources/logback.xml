<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <variable name="LOG_LEVEL" value="${MADA_LOG_LEVEL:-INFO}" />
    <variable name="LOG_DIR" value="${MADA_LOG_DIR:-${user.home}/.mada/logs}" />
    <variable name="DEBUG_DIR" value="${MADA_DEBUG_DIR}" />

    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/mada.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level [%X{sessionId:-}-/%X{turnId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/mada.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [%X{sessionId:-}-/%X{turnId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SESSION_DEBUG" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>sessionId</key>
            <defaultValue>bootstrap</defaultValue>
        </discriminator>
        <sift>
            <appender name="DEBUG-${sessionId}" class="ch.qos.logback.core.FileAppender">
                <file>${DEBUG_DIR}/${sessionId}.log</file>
                <append>true</append>
                <encoder>
                    <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level [%X{sessionId:-}-/%X{turnId:-}] %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <if condition='(property("MADA_LOG_TO_STDERR").equalsIgnoreCase("true")) &amp;&amp; (property("MADA_DEBUG").equalsIgnoreCase("true") || property("MADA_DEBUG").equals("1"))'>
        <then>
            <root level="DEBUG">
                <appender-ref ref="ROLLING_FILE" />
                <appender-ref ref="STDERR" />
                <appender-ref ref="SESSION_DEBUG" />
            </root>
        </then>
        <else>
            <if condition='property("MADA_LOG_TO_STDERR").equalsIgnoreCase("true")'>
                <then>
                    <root level="${LOG_LEVEL}">
                        <appender-ref ref="ROLLING_FILE" />
                        <appender-ref ref="STDERR" />
                    </root>
                </then>
                <else>
                    <if condition='property("MADA_DEBUG").equalsIgnoreCase("true") || property("MADA_DEBUG").equals("1")'>
                        <then>
                            <root level="DEBUG">
                                <appender-ref ref="ROLLING_FILE" />
                                <appender-ref ref="SESSION_DEBUG" />
                            </root>
                        </then>
                        <else>
                            <root level="${LOG_LEVEL}">
                                <appender-ref ref="ROLLING_FILE" />
                            </root>
                        </else>
                    </if>
                </else>
            </if>
        </else>
    </if>
</configuration>
